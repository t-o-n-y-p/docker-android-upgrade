ARG K8S_APPIUM_VERSION

FROM budtmo/docker-android:emulator_14.0_v${K8S_APPIUM_VERSION}-p0
USER root

#==================
# Android Packages
#==================
ARG K8S_ANDROID_VERSION
ARG K8S_API_LEVEL
ENV EMULATOR_ANDROID_VERSION=${K8S_ANDROID_VERSION} \
    EMULATOR_API_LEVEL=${K8S_API_LEVEL} \
    EMULATOR_SYS_IMG=x86_64 \
    EMULATOR_IMG_TYPE=google_apis \
    EMULATOR_BROWSER=chrome
ENV PATH=${PATH}:${ANDROID_HOME}/build-tools
RUN yes | sdkmanager --uninstall "platforms;android-34" \
 "system-images;android-34;google_apis;x86_64"
RUN yes | sdkmanager --licenses && sdkmanager "platforms;android-${EMULATOR_API_LEVEL}" \
 "system-images;android-${EMULATOR_API_LEVEL};${EMULATOR_IMG_TYPE};${EMULATOR_SYS_IMG}"

#==========
# Copy app
#==========
RUN rm -rf ${SCRIPT_PATH}
ENV SCRIPT_PATH="docker-android"
ENV APP_PATH=${WORK_PATH}/${SCRIPT_PATH}
RUN mkdir -p ${APP_PATH}
COPY mixins ${APP_PATH}/mixins
COPY cli ${APP_PATH}/cli
RUN echo "${USERNAME} ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

#==================
# Use created user
#==================
USER ${USERID}:${GROUPID}

#=========
# Run App
#=========
STOPSIGNAL SIGTERM
ENV DEVICE_TYPE=emulator
CMD ["${APP_PATH}/mixins/scripts/run.sh"]
